MONSTRA_API_KEY=
MONSTRA_API_BASE_URL=https://www.monstra.bot

WEBULL_APP_KEY=
WEBULL_APP_SECRET=
# Leave blank on the first run to print your accounts and their IDs.
WEBULL_ACCOUNT_ID=

# "sandbox" (default, recommended to start) or "production"
WEBULL_ENV=sandbox

# true = print/log the plan only. Set to false only once you're ready to place real trades.
DRY_RUN=true
MIN_TRADE_DOLLARS=25

# Optional overrides -- defaults are fine for most setups.
# WEBULL_OPENAPI_TOKEN_DIR=C:\Users\you\.monstra_webull_tokens
# WEBULL_LOG_FILE_PATH=C:\path\to\webull_rebalance.log
